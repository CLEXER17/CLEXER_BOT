# CLEXER Music - separate Railway service. Root directory: music/
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl unzip ca-certificates git gnupg && rm -rf /var/lib/apt/lists/*
# Node 20 + the bgutil PO-token provider: YouTube hands "Sign in to confirm
# you're not a bot" to datacenter IPs; a proof-of-origin token (generated by
# Google's own BotGuard script, run here in Node) is yt-dlp's standard way
# through that wall. It runs as a tiny local HTTP service (start.sh).
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null 2>&1 && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --single-branch --branch 2.0.0 https://github.com/Brainicism/bgutil-ytdlp-pot-provider /app/bgutil \
    && cd /app/bgutil/server && npm ci && npx tsc && ls build/main.js
# deno: yt-dlp's JavaScript runtime for YouTube's player challenge (without it some formats are missing)
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh -s -- -y >/dev/null 2>&1 || true
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# yt-dlp must be current - YouTube changes break old versions. This layer is
# rebuilt on every deploy (the ARG changes with the git commit), never cached.
ARG RAILWAY_GIT_COMMIT_SHA=dev
RUN echo "build $RAILWAY_GIT_COMMIT_SHA" && pip install --no-cache-dir -U yt-dlp bgutil-ytdlp-pot-provider && python -c "import yt_dlp; print('yt-dlp', yt_dlp.version.__version__)"
# Tailscale (optional): with TS_AUTHKEY + TS_EXIT_NODE set, YouTube traffic
# leaves through a device of yours (a phone / PC at home) instead of the
# server's datacenter IP - see start.sh. Nothing runs when they are unset.
RUN curl -fsSL https://tailscale.com/install.sh | sh >/dev/null 2>&1 || true
COPY service.py start.sh .
RUN chmod +x start.sh
CMD ["./start.sh"]
